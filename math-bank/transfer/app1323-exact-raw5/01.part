asst1suhy000520","minor":"大問2","tags":["Winpass","中1","25winpasst1suhy000520","M02","S02"]},"title":"Winpass 中1 25winpasst1suhy000520 M02-S02","skill":"原本構造 M02/S02","question_format":"free_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000520.docx","original_no":"Winpass:25winpasst1suhy000520.docx:M02:S02","is_generated_variant":false},"question":"２ 次の問いに答えなさい。 半径6 cm、中心角60°のおうぎ形の面積を求めなさい。","choices":null,"answer":"6 π cm^(2)","explanation":"","figure_refs":[],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000520.docx:M02:S03","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000520","minor":"大問2","tags":["Winpass","中1","25winpasst1suhy000520","M02","S03"]},"title":"Winpass 中1 25winpasst1suhy000520 M02-S03","skill":"原本構造 M02/S03","question_format":"free_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000520.docx","original_no":"Winpass:25winpasst1suhy000520.docx:M02:S03","is_generated_variant":false},"question":"２ 次の問いに答えなさい。 半径18 cm、中心角45°のおうぎ形の弧の長さを求めなさい。","choices":null,"answer":"(9)/( 2 )π cm","explanation":"","figure_refs":[],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000520.docx:M02:S04","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000520","minor":"大問2","tags":["Winpass","中1","25winpasst1suhy000520","M02","S04"]},"title":"Winpass 中1 25winpasst1suhy000520 M02-S04","skill":"原本構造 M02/S04","question_format":"free_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000520.docx","original_no":"Winpass:25winpasst1suhy000520.docx:M02:S04","is_generated_variant":false},"question":"２ 次の問いに答えなさい。 半径4cm、弧の長さ4 π cmのおうぎ形の中心角の大きさを求めなさい。","choices":null,"answer":"180°","explanation":"","figure_refs":[],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000520.docx:M03:S01","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000520","minor":"大問3","tags":["Winpass","中1","25winpasst1suhy000520","M03","S01"]},"title":"Winpass 中1 25winpasst1suhy000520 M03-S01","skill":"原本構造 M03/S01","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000520.docx","original_no":"Winpass:25winpasst1suhy000520.docx:M03:S01","is_generated_variant":false},"question":"３⑴ 1辺4cmの正方形と半径4cmの4分の1円を組み合わせた図の斜線部分の面積を求めなさい。\n[[IMAGE:assets/math/cdc69684a1b6626d7b60efd39be61c237318e99459a8eb8d1de75867f9cc5557.png]]","choices":null,"answer":"16-4π(cm^(2))","explanation":"","figure_refs":["assets/math/cdc69684a1b6626d7b60efd39be61c237318e99459a8eb8d1de75867f9cc5557.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000520.docx:M03:S02","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000520","minor":"大問3","tags":["Winpass","中1","25winpasst1suhy000520","M03","S02"]},"title":"Winpass 中1 25winpasst1suhy000520 M03-S02","skill":"原本構造 M03/S02","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000520.docx","original_no":"Winpass:25winpasst1suhy000520.docx:M03:S02","is_generated_variant":false},"question":"３⑵ 1辺6cmの正方形の4隅に半径3cmの4分の1円を組み合わせた図の斜線部分の面積を求めなさい。\n[[IMAGE:assets/math/cdc69684a1b6626d7b60efd39be61c237318e99459a8eb8d1de75867f9cc5557.png]]","choices":null,"answer":"9πcm^(2)","explanation":"","figure_refs":["assets/math/cdc69684a1b6626d7b60efd39be61c237318e99459a8eb8d1de75867f9cc5557.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000521.docx:M01:S01","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000521","minor":"大問1","tags":["Winpass","中1","25winpasst1suhy000521","M01","S01"]},"title":"Winpass 中1 25winpasst1suhy000521 M01-S01","skill":"原本構造 M01/S01","question_format":"graphical_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000521.docx","original_no":"Winpass:25winpasst1suhy000521.docx:M01:S01","is_generated_variant":false},"question":"１ 次の作図をしなさい。⑴〜⑸ 線分ABの垂直二等分線を作図しなさい。\n[[IMAGE:assets/math/c75be70bcd349287b0fbd8188bd5908cabfe1759a88f97c924e08a762ba89869.png]]","choices":null,"answer":"[作図解答] A・Bから等半径の円弧を描き、その2交点を結ぶ垂直二等分線。","explanation":"","figure_refs":["assets/math/c75be70bcd349287b0fbd8188bd5908cabfe1759a88f97c924e08a762ba89869.png","assets/math/298f7df4dd839c1ea9b725733220ff3ae0bf2f83e28f7773717a494afdd82350.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000521.docx:M01:S02","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000521","minor":"大問1","tags":["Winpass","中1","25winpasst1suhy000521","M01","S02"]},"title":"Winpass 中1 25winpasst1suhy000521 M01-S02","skill":"原本構造 M01/S02","question_format":"graphical_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000521.docx","original_no":"Winpass:25winpasst1suhy000521.docx:M01:S02","is_generated_variant":false},"question":"１ 次の作図をしなさい。⑴〜⑸ ∠AOBの二等分線を作図しなさい。\n[[IMAGE:assets/math/c75be70bcd349287b0fbd8188bd5908cabfe1759a88f97c924e08a762ba89869.png]]","choices":null,"answer":"[作図解答] O中心の円弧とその交点から等半径の円弧を描き、Oと円弧の交点を結ぶ角の二等分線。","explanation":"","figure_refs":["assets/math/c75be70bcd349287b0fbd8188bd5908cabfe1759a88f97c924e08a762ba89869.png","assets/math/eab9f6979168486344bd0bcdae2100d2bc6ead639075d24253a69ae304251842.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000521.docx:M01:S03","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000521","minor":"大問1","tags":["Winpass","中1","25winpasst1suhy000521","M01","S03"]},"title":"Winpass 中1 25winpasst1suhy000521 M01-S03","skill":"原本構造 M01/S03","question_format":"graphical_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000521.docx","original_no":"Winpass:25winpasst1suhy000521.docx:M01:S03","is_generated_variant":false},"question":"１ 次の作図をしなさい。⑴〜⑸ 点Pを通り、直線ℓに垂直な直線を作図しなさい。\n[[IMAGE:assets/math/b34f24281bdd75bb1fd57510d730c9e380c2af06f82dde2ee027292087c0ac87.png]]","choices":null,"answer":"[作図解答] Pを通る直線ℓの垂線。","explanation":"","figure_refs":["assets/math/b34f24281bdd75bb1fd57510d730c9e380c2af06f82dde2ee027292087c0ac87.png","assets/math/1c9837316e808a3eb8bd43e875fb08893c3e2f95677f3d99fffb908b14edf187.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000521.docx:M01:S04","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000521","minor":"大問1","tags":["Winpass","中1","25winpasst1suhy000521","M01","S04"]},"title":"Winpass 中1 25winpasst1suhy000521 M01-S04","skill":"原本構造 M01/S04","question_format":"graphical_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000521.docx","original_no":"Winpass:25winpasst1suhy000521.docx:M01:S04","is_generated_variant":false},"question":"１ 次の作図をしなさい。⑴〜⑸ 点Qを通り、直線mに垂直な直線を作図しなさい。\n[[IMAGE:assets/math/b34f24281bdd75bb1fd57510d730c9e380c2af06f82dde2ee027292087c0ac87.png]]","choices":null,"answer":"[作図解答] Qを通る直線mの垂線。","explanation":"","figure_refs":["assets/math/b34f24281bdd75bb1fd57510d730c9e380c2af06f82dde2ee027292087c0ac87.png","assets/math/86ef462f624c6d90ec984ffa946a244377c440ef614620a1c3b3af328c6ceee6.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000521.docx:M01:S05","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000521","minor":"大問1","tags":["Winpass","中1","25winpasst1suhy000521","M01","S05"]},"title":"Winpass 中1 25winpasst1suhy000521 M01-S05","skill":"原本構造 M01/S05","question_format":"graphical_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000521.docx","original_no":"Winpass:25winpasst1suhy000521.docx:M01:S05","is_generated_variant":false},"question":"１ 次の作図をしなさい。⑴〜⑸ 3辺AB、BC、CAが図に示された長さとなる△ABCを作図しなさい。\n[[IMAGE:assets/math/94ade5da9c38d3624e92125d1d142e17bb014c0a5816fc335aab739fb5a9ca8d.png]]","choices":null,"answer":"[作図解答] 与えられた3辺長を半径とする円弧の交点を用いて△ABCを作図。","explanation":"","figure_refs":["assets/math/94ade5da9c38d3624e92125d1d142e17bb014c0a5816fc335aab739fb5a9ca8d.png","assets/math/1872aeffd1a6a6a3b636d3f36dd74bd815fd73873d3573e8f1ee59c68b6a5d5b.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000522.docx:M01:S01","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000522","minor":"大問1","tags":["Winpass","中1","25winpasst1suhy000522","M01","S01"]},"title":"Winpass 中1 25winpasst1suhy000522 M01-S01","skill":"原本構造 M01/S01","question_format":"graphical_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000522.docx","original_no":"Winpass:25winpasst1suhy000522.docx:M01:S01","is_generated_variant":false},"question":"１ 次の作図をしなさい。 ∠XOA=30°となる半直線OAを作図しなさい（∠XOY=90°）。\n[[IMAGE:assets/math/b4ed627fad88d5828b6e02031413b539b27f5ffa241c1416f21ab05190e1f15d.png]]","choices":null,"answer":"[作図解答] 90°を二等分して45°ではなく、60°を作ってその半分を利用し、X軸から30°の半直線OAを作図。","explanation":"","figure_refs":["assets/math/b4ed627fad88d5828b6e02031413b539b27f5ffa241c1416f21ab05190e1f15d.png","assets/math/46c481c9aeeedc4dcc5016003d589282ebcdb02f33d6e0b3614828d0a3eed444.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000522.docx:M01:S02","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000522","minor":"大問1","tags":["Winpass","中1","25winpasst1suhy000522","M01","S02"]},"title":"Winpass 中1 25winpasst1suhy000522 M01-S02","skill":"原本構造 M01/S02","question_format":"graphical_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000522.docx","original_no":"Winpass:25winpasst1suhy000522.docx:M01:S02","is_generated_variant":false},"question":"１ 次の作図をしなさい。 点Aを接点とする円Oの接線を作図しなさい。\n[[IMAGE:assets/math/b4ed627fad88d5828b6e02031413b539b27f5ffa241c1416f21ab05190e1f15d.png]]","choices":null,"answer":"[作図解答] 半径OAに点Aで垂直な直線を作図。","explanation":"","figure_refs":["assets/math/b4ed627fad88d5828b6e02031413b539b27f5ffa241c1416f21ab05190e1f15d.png","assets/math/ea10afd0e098f1603681092a66b5d32dc1fcf209fac329c48e61e28f030d473d.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000522.docx:M01:S03","grade":1,"unit":{"major":"Winpass / 25winpasst1suhy000522","minor":"大問1","tags":["Winpass","中1","25winpasst1suhy000522","M01","S03"]},"title":"Winpass 中1 25winpasst1suhy000522 M01-S03","skill":"原本構造 M01/S03","question_format":"graphical_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst1suhy000522.docx","original_no":"Winpass:25winpasst1suhy000522.docx:M01:S03","is_generated_variant":false},"question":"１ 次の作図をしなさい。 点Aを中心として直線ℓに接する円を作図しなさい。\n[[IMAGE:assets/math/009f25a529e3ecdf252164bf8374b288ddba42a2fa3f25e87c6ad06608551409.png]]","choices":null,"answer":"[作図解答] Aからℓへ垂線を下ろし、その距離を半径としてA中心の円を作図。","explanation":"","figure_refs":["assets/math/009f25a529e3ecdf252164bf8374b288ddba42a2fa3f25e87c6ad06608551409.png","assets/math/3f32a4c4aa3ef65a02d078a5883c64ba87760d7b72aea54fd897b8b1f176523f.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst1suhy000522.docx:M01:S04","grade":1,"u