th/18ed5a5e597819941b5be0783c5badf09222ce2e347984b4f4c906f62728fdb5.png]]\n[[IMAGE:assets/math/e84458192c643e48c094c35cb6eb2af4ab6d3e0c913ced2260d1e432e3e00676.png]]","choices":null,"answer":"2組の辺とその間の角がそれぞれ等しい。","explanation":"","figure_refs":["assets/math/18ed5a5e597819941b5be0783c5badf09222ce2e347984b4f4c906f62728fdb5.png","assets/math/e84458192c643e48c094c35cb6eb2af4ab6d3e0c913ced2260d1e432e3e00676.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst2suhy000519.docx:M01:S02","grade":2,"unit":{"major":"Winpass / 25winpasst2suhy000519","minor":"大問1","tags":["Winpass","中2","25winpasst2suhy000519","M01","S02"]},"title":"Winpass 中2 25winpasst2suhy000519 M01-S02","skill":"原本構造 M01/S02","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst2suhy000519.docx","original_no":"Winpass:25winpasst2suhy000519.docx:M01:S02","is_generated_variant":false},"question":"１　次の①、②の三角形はどれも△ABCと合同であると判断できる。その判断の根拠となる三角形の合同条件をそれぞれ答えなさい。 ⑴②\n[[IMAGE:assets/math/18ed5a5e597819941b5be0783c5badf09222ce2e347984b4f4c906f62728fdb5.png]]\n[[IMAGE:assets/math/60286d4ba11141efa77824e0e0c66ee0b12f8cfe98a8f9ba468dd09a2a8ef849.png]]","choices":null,"answer":"3組の辺がそれぞれ等しい。","explanation":"","figure_refs":["assets/math/18ed5a5e597819941b5be0783c5badf09222ce2e347984b4f4c906f62728fdb5.png","assets/math/60286d4ba11141efa77824e0e0c66ee0b12f8cfe98a8f9ba468dd09a2a8ef849.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst2suhy000519.docx:M01:S03","grade":2,"unit":{"major":"Winpass / 25winpasst2suhy000519","minor":"大問1","tags":["Winpass","中2","25winpasst2suhy000519","M01","S03"]},"title":"Winpass 中2 25winpasst2suhy000519 M01-S03","skill":"原本構造 M01/S03","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst2suhy000519.docx","original_no":"Winpass:25winpasst2suhy000519.docx:M01:S03","is_generated_variant":false},"question":"１　次の①、②の三角形はどれも△ABCと合同であると判断できる。その判断の根拠となる三角形の合同条件をそれぞれ答えなさい。 ⑵①\n[[IMAGE:assets/math/366f2fe1d849fc9c36939b7a5940bc3665624a46a29458585de96c723bcd5702.png]]\n[[IMAGE:assets/math/96ff00c46c35fb532ce654965e3e184c0c7d217e83447d08fdad42e92419f631.png]]","choices":null,"answer":"直角三角形において、斜辺と他の1辺がそれぞれ等しい。","explanation":"","figure_refs":["assets/math/366f2fe1d849fc9c36939b7a5940bc3665624a46a29458585de96c723bcd5702.png","assets/math/96ff00c46c35fb532ce654965e3e184c0c7d217e83447d08fdad42e92419f631.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst2suhy000519.docx:M01:S04","grade":2,"unit":{"major":"Winpass / 25winpasst2suhy000519","minor":"大問1","tags":["Winpass","中2","25winpasst2suhy000519","M01","S04"]},"title":"Winpass 中2 25winpasst2suhy000519 M01-S04","skill":"原本構造 M01/S04","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst2suhy000519.docx","original_no":"Winpass:25winpasst2suhy000519.docx:M01:S04","is_generated_variant":false},"question":"１　次の①、②の三角形はどれも△ABCと合同であると判断できる。その判断の根拠となる三角形の合同条件をそれぞれ答えなさい。 ⑵②\n[[IMAGE:assets/math/366f2fe1d849fc9c36939b7a5940bc3665624a46a29458585de96c723bcd5702.png]]\n[[IMAGE:assets/math/26b5b627b2be422a9190851fd4110047fff09954e010a6819c6d7ed0c08632cc.png]]","choices":null,"answer":"直角三角形において、斜辺と1つの鋭角がそれぞれ等しい。","explanation":"","figure_refs":["assets/math/366f2fe1d849fc9c36939b7a5940bc3665624a46a29458585de96c723bcd5702.png","assets/math/26b5b627b2be422a9190851fd4110047fff09954e010a6819c6d7ed0c08632cc.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst2suhy000519.docx:M02:S01","grade":2,"unit":{"major":"Winpass / 25winpasst2suhy000519","minor":"大問2","tags":["Winpass","中2","25winpasst2suhy000519","M02","S01"]},"title":"Winpass 中2 25winpasst2suhy000519 M02-S01","skill":"原本構造 M02/S01","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst2suhy000519.docx","original_no":"Winpass:25winpasst2suhy000519.docx:M02:S01","is_generated_variant":false},"question":"２　右の図のように、線分ABの中点をMとする。∠ACM=∠BDM=90°であるとき、CM=DMであることを証明しなさい。\n[[IMAGE:assets/math/6facb2e1594cdeca21f4f8427b1e39209c2ef537dce2cc0eae9b6800a281b4a0.png]]","choices":null,"answer":"△ACMと△BDMにおいて、仮定よりAM=BM…①、∠ACM=∠BDM=90°…②。対頂角は等しいので∠AMC=∠BMD…③。①、②、③より、直角三角形において斜辺と1つの鋭角がそれぞれ等しいので、△ACM≡△BDM。よって、CM=DM。","explanation":"","figure_refs":["assets/math/6facb2e1594cdeca21f4f8427b1e39209c2ef537dce2cc0eae9b6800a281b4a0.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst2suhy000519.docx:M03:S01","grade":2,"unit":{"major":"Winpass / 25winpasst2suhy000519","minor":"大問3","tags":["Winpass","中2","25winpasst2suhy000519","M03","S01"]},"title":"Winpass 中2 25winpasst2suhy000519 M03-S01","skill":"原本構造 M03/S01","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst2suhy000519.docx","original_no":"Winpass:25winpasst2suhy000519.docx:M03:S01","is_generated_variant":false},"question":"３　右の図のように、∠XOYの二等分線上に点Pをとり、PからOX、OYにそれぞれ垂線PA、PBをひく。このとき、OA=OBとなることを証明しなさい。\n[[IMAGE:assets/math/f37964fa64a5e4bffd4131f4bfd36a33d0cc56b0c4f860f37fe2cb644b60581a.png]]","choices":null,"answer":"△OAPと△OBPにおいて、仮定より∠AOP=∠BOP…①、∠OAP=∠OBP=90°…②、OP=OP…③。①、②、③より、直角三角形において斜辺と1つの鋭角がそれぞれ等しいので、△OAP≡△OBP。よって、OA=OB。","explanation":"","figure_refs":["assets/math/f37964fa64a5e4bffd4131f4bfd36a33d0cc56b0c4f860f37fe2cb644b60581a.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst2suhy000520.docx:M01:S01","grade":2,"unit":{"major":"Winpass / 25winpasst2suhy000520","minor":"大問1","tags":["Winpass","中2","25winpasst2suhy000520","M01","S01"]},"title":"Winpass 中2 25winpasst2suhy000520 M01-S01","skill":"原本構造 M01/S01","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst2suhy000520.docx","original_no":"Winpass:25winpasst2suhy000520.docx:M01:S01","is_generated_variant":false},"question":"証明の空欄㋐\n[[IMAGE:assets/math/4f44ef4bc32b3c7c295057a43be10296340f7ce572a1b4bd59832e047329554c.png]]","choices":null,"answer":"AD=CB","explanation":"","figure_refs":["assets/math/4f44ef4bc32b3c7c295057a43be10296340f7ce572a1b4bd59832e047329554c.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst2suhy000520.docx:M01:S02","grade":2,"unit":{"major":"Winpass / 25winpasst2suhy000520","minor":"大問1","tags":["Winpass","中2","25winpasst2suhy000520","M01","S02"]},"title":"Winpass 中2 25winpasst2suhy000520 M01-S02","skill":"原本構造 M01/S02","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst2suhy000520.docx","original_no":"Winpass:25winpasst2suhy000520.docx:M01:S02","is_generated_variant":false},"question":"証明の空欄㋑\n[[IMAGE:assets/math/4f44ef4bc32b3c7c295057a43be10296340f7ce572a1b4bd59832e047329554c.png]]","choices":null,"answer":"∠OCB","explanation":"","figure_refs":["assets/math/4f44ef4bc32b3c7c295057a43be10296340f7ce572a1b4bd59832e047329554c.png"],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst2suhy000520.docx:M01:S03","grade":2,"unit":{"major":"Winpass / 25winpasst2suhy000520","minor":"大問1","tags":["Winpass","中2","25winpasst2suhy000520","M01","S03"]},"title":"Winpass 中2 25winpasst2suhy000520 M01-S03","skill":"原本構造 M01/S03","question_format":"figure_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst2suhy0005