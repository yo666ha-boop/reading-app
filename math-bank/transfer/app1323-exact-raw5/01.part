erified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst3suhy000728.docx:M02:S01","grade":3,"unit":{"major":"Winpass / 25winpasst3suhy000728","minor":"大問2","tags":["Winpass","中3","25winpasst3suhy000728","M02","S01"]},"title":"Winpass 中3 25winpasst3suhy000728 M02-S01","skill":"原本構造 M02/S01","question_format":"free_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst3suhy000728.docx","original_no":"Winpass:25winpasst3suhy000728.docx:M02:S01","is_generated_variant":false},"question":"２ 次の問いに答えなさい。 ⑴ 袋の中に赤玉と青玉が合計で120個入っている。袋の中をよくか き混ぜてからひとつかみの玉を取り出して数えると、赤玉が2個、 青玉が3個であった。袋の中にはおよそ何個の青玉が入っていたと推 定できるか答えなさい。","choices":null,"answer":"およそ72 個","explanation":"","figure_refs":[],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst3suhy000728.docx:M02:S02","grade":3,"unit":{"major":"Winpass / 25winpasst3suhy000728","minor":"大問2","tags":["Winpass","中3","25winpasst3suhy000728","M02","S02"]},"title":"Winpass 中3 25winpasst3suhy000728 M02-S02","skill":"原本構造 M02/S02","question_format":"free_response","difficulty":"unknown","source":{"book":"Winpass","document":"25winpasst3suhy000728.docx","original_no":"Winpass:25winpasst3suhy000728.docx:M02:S02","is_generated_variant":false},"question":"２ 次の問いに答えなさい。 ⑵ ある工場では、1日に6 万個の製品がつくられている。そのうちの 400 個を無作為に選び、製品検査を行ったところ3個の不良品があっ た。この工場では、1日におよそ何個の不良品があると推定できるか 答えなさい。","choices":null,"answer":"およそ450 個","explanation":"","figure_refs":[],"variant_group":null,"audit":{"problem_answer_verified":true,"structure_verified":true,"figure_refs_verified":true}},{"id":"orig:Winpass:25winpasst3suhy000728.docx:M02:S03","grade":3,"unit":{"major":"Winpass / 25winpasst3suhy000728","minor":"大問2","tags":["Winpass","中3","25winpasst3suhy000728","M02","S03"]},"title":"Winpass 中3 25winpasst3suhy000728 M02-S03","skill":"原本構造 M02/S03","question_format":"free_response","difficulty":"unknown","source":{"b